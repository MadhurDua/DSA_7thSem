class Solution {
    private int count = 0;

    public int totalNQueens(int n) {
        boolean[] columns = new boolean[n];
        boolean[] diagonals1 = new boolean[2 * n - 1];
        boolean[] diagonals2 = new boolean[2 * n - 1];

        solve(0, n, columns, diagonals1, diagonals2);
        return count;
    }

    private void solve(int row, int n, boolean[] columns,
                       boolean[] diagonals1, boolean[] diagonals2) {
        if (row == n) {
            count++;
            return;
        }

        for (int col = 0; col < n; col++) {
            int diagonal1 = row - col + n - 1;
            int diagonal2 = row + col;

            if (columns[col] || diagonals1[diagonal1] || diagonals2[diagonal2]) {
                continue;
            }

            columns[col] = true;
            diagonals1[diagonal1] = true;
            diagonals2[diagonal2] = true;

            solve(row + 1, n, columns, diagonals1, diagonals2);

            columns[col] = false;
            diagonals1[diagonal1] = false;
            diagonals2[diagonal2] = false;
        }
    }
}
